# 复制为 .env 并填写真实值。.env 不入库;缺省的项看下方注释按需补齐。

# Postgres 连接串(开发库)
DATABASE_URL="postgresql+psycopg://USER:PASSWORD@localhost:5432/producthub"

# 应用对外地址:决定邮件里链接的前缀,以及 cookie 是否带 Secure(https 才带,本地 http 才能登录)。
# 本地开发默认即可不填(http://localhost:5173);线上务必填 Railway 域名。
# APP_BASE_URL="https://xxx.up.railway.app"

# ---- 邮件:管理员建用户账号(邀请)/ 重置密码靠它发信 ----
# SMTP_FROM 必填。发送通道二选一(后端按优先级自动选择):
#   ① 配 SMTP_HOST + SMTP_*(任意 SMTP,587 或 465);
#   ② Resend 用户配 RESEND_API_KEY(与下面 SMTP_PASSWORD 是同一把 re_...)+ SMTP_FROM:
#      自动改走 https://api.resend.com/emails(443)。云平台常封 SMTP 出站端口,
#      Railway 等部署若 SMTP 发送超时,用这条最稳(SMTP_HOST 可留空不配)。
# SMTP_HOST 与 SMTP_FROM 都缺、或 RESEND_API_KEY 与 SMTP_FROM 都缺 → 视为未配置,
# 此时创建/重置接口返回 503(不留半截账号)。
# RESEND_API_KEY="re_..."          # 填了就走 Resend HTTP API(443),SMTP_HOST/SMTP_USERNAME 可省
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587                    # 常用 587(STARTTLS);若平台封 587 出站,改 465 = SMTPS 隐式 TLS(自动走 SMTP_SSL)
# SMTP_STARTTLS="1"                # 仅 587 等普通端口生效,默认开;设 "0" 关闭(自建/明文内网 SMTP;465 不需要它)
# SMTP_USERNAME="you@example.com"
# SMTP_PASSWORD="授权码或密码"       # QQ 邮箱填授权码;Resend/Mailgun 填 API key
# SMTP_FROM="no-reply@example.com"  # 发件邮箱(域名需先在 Resend 里验证过)
# SMTP_FROM_NAME="producthub"       # 发件显示名,可选

# ---- 首个管理员引导(只在「库里一个账号都没有」时生效,幂等)----
# 本地首启 / Railway 首部署时配置;管理员建好用户账号后即可从 .env 移除,防止泄露。
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="请改成强密码"
# ADMIN_NAME="管理员"

# ---- AI 助手(第六版)----
# 照邮件那套:**没配就是「AI 未配置」的状态,不是报错** —— 界面显示「未配置」,
# 提问接口返回 503,站内其它功能完全不受影响。
#
# DEEPSEEK_API_KEY 是唯一必须填的一项。**余额从这里扣**(platform.deepseek.com)。
# DEEPSEEK_API_KEY="sk-..."

# 模型名**绝不硬编码**:DeepSeek 已经改过一轮命名,`deepseek-v4-flash` 现在是退役别名。
# 现行:deepseek-flash(快)/ deepseek-v4-pro(强)。不填默认 deepseek-flash。
# AI_MODEL="deepseek-flash"

# 接口地址。只有走自建代理 / 官方换域名时才需要改。
# ⚠️ 指到本机(如 http://127.0.0.1:8899 挂个假上游调试)时,若这台机器开了系统代理,
#    Python 的 urllib 会把 127.0.0.1 也发进代理,于是拿到一个没头没脑的 502、而上游
#    一条请求都没收到。这时启动后端要带上:no_proxy=127.0.0.1,localhost
# AI_BASE_URL="https://api.deepseek.com"

# 一次提问(含多轮工具调用)的**总时间预算**(秒,默认 120)。超了就停下,
# 把已经拿到的部分作为回答给出,并注明「已到检索时间上限」。
# **这个 120 是实测定的**:真 key 上量到一次往返约 1.8–2.7 秒,6 次调用 ≈ 十几秒,
# 120 秒是它的 5 倍以上余量。
# ⚠️ **第七版起调小它不再安全**:预算到点只是我们不再等 dsh,那一轮在后台照跑
#    (dsh SDK 没有取消接口)—— 以前调小 = 长回答被截,现在调小 = 截断的同时钱照花。
# ⚠️ 请求能挂多久 = 这个预算 + 1 秒。`AI_TIMEOUT` 在第七版删了(没有调用方),
#    上游读取现在不设截止时间(SDK 的 request_timeout_seconds 默认 None)。
# AI_WALL_CLOCK_BUDGET=120

# 思考强度,合法值 off / low / high / max。不给**效果**就是 high —— 但不给 = 这个字段
#    根本不发,由服务端兜底;DeepSeek 官方文档:「思考模式默认开,默认 effort 就是 high」。
#    (要省钱设 low。官方还认 medium / xhigh,内部都映射成 high,写了等于没写。)
# **这里不校验**:与 AI_MODEL 同理,值由部署者负责,dsh 会在启动时明确拒绝非法值
# (自己再维护一份白名单,等于给以后新增的档位埋一颗「我们悄悄忽略了它」的雷)。
# ⚠️ 它是**实例级**的(dsh 的 AgentOptions 字段,建 agent 时定死),所以进了实例池
#    的键 —— 与界面上那个 token 上限同理。第七版起不再有 temperature 之类,
#    它们在思考模式下设了不报错但完全无效。
# AI_REASONING_EFFORT="high"

# ---- dsh(DeepSeek Harness)专用:AI 内核本体 ----
# 第六版的内核是我们自己手写的 HTTP 循环,第七版换成了官方 agent 框架 dsh。
# 下面这些**平时一个都不用配**,列出来是为了出事时知道往哪拧。

# dsh 的 profile 名(默认 sdk-minimal)。dsh 用它决定挂哪些插件 —— 我们给每个
# 提问者生成的那份 patch 就是叠加在它上面的。
# DSH_PROFILE="sdk-minimal"

# dsh 的工作目录:会话 JSONL、profile、按提问者生成的 patch 都落在这里。
# **必须可写**;不要去挂卷,里面存的是被我们刻意放弃的历史(上下文由 Postgres 重放)。
# 镜像里显式设成 /app/.dsh(见 Dockerfile)。
# AI_DSH_HOME="/app/.dsh"

# 给 dsh 的 cwd。**必须存在**,里面刻意什么都不放 —— 模型没有文件类工具,
# 这个目录它碰不到,存在的意义只是满足运行时的 cwd 要求。
# ⚠️ **不要指向项目根**:万一将来有人误开了某个文件工具,爆炸半径会从
#    「一个空目录」变成「整个仓库」。
# AI_DSH_WORKSPACE="/app/.dsh/workspace"

# dsh 实例空闲多久回收(秒,默认 600)。一个实例 = 1 个 node 进程 + 1 个工具服务进程,
# 所以池子只进不出会攒进程。**也决定了「改了 token 上限多久生效」**:上限进了实例池
# 的键,但旧实例会继续用它自己的旧值服务到被回收为止。
# AI_HARNESS_IDLE_TTL=600

# 启动 dsh 实例的超时(秒,默认 30)。真机实测 0.5–0.6 秒,慢过这个值说明环境有问题
# (架构不对 / glibc 太旧 —— 构建镜像时那条 dsh_runtime_check 会提前拦住)。
# AI_HARNESS_START_TIMEOUT=30
